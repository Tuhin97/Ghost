# Copy to .env and fill in your values. Never commit .env.

# Required
ANTHROPIC_API_KEY=
JWT_SECRET=

# Devices
THINKPAD_TAILSCALE_IP=
MAC_HOST=
MAC_USER=
LINUX_USER=
SSH_KEY_PATH=~/.ssh/id_ed25519

# Device tokens (generate with auth.py)
DEVICE_TOKEN_THINKPAD=
DEVICE_TOKEN_MACBOOK=
DEVICE_TOKEN_SAMSUNG=
DEVICE_TOKEN_IPHONE=

# Memory encryption (Fernet key)
MEMORY_ENCRYPTION_KEY=

# Google (Gmail + Calendar)
GMAIL_CREDENTIALS_PATH=./credentials.json

# GitHub
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_REPOS=

# Job search
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
CV_PATH=~/Documents/Your_CV.docx
JOB_PIPELINE_EMAIL=
JOB_PIPELINE_KEYWORDS=python,data science,AI
JOB_PIPELINE_LOCATION=Adelaide

# Voice
PIPER_MODEL_PATH=./voice/models/en_US-lessac-medium.onnx
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=ghost
MQTT_PASSWORD=

# Optional integrations
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
TAVILY_API_KEY=
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
